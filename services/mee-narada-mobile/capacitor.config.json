{
  "appId": "com.meenarada.app",
  "appName": "Mee Narada",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "hostname": "mobile.meenarada.com"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#ffffff",
    "scrollEnabled": false
  },
  "android": {
    "allowMixedContent": false,
    "minWebViewVersion": 110
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#bf193b",
      "overlaysWebView": true
    }
  }
}
